 "BLK-AZ-INSURANCE-SELECT": {
  "screen": "AZG100+popup",
  "steps": [
   {
    "event": "click (保険種類欄の横)",
    "action": "click",
    "selector": "input[name=\"selectInsuransuItem\"]"
   },
   {
    "event": "ast 遷移 保険種類選択",
    "action": "popup",
    "match": "insurance_item_select|popup.html"
   },
   {
    "event": "click 保険種類",
    "action": "selectOptionByLabel",
    "selector": "select[name=\"insurance_item_list.selected\"]",
    "label": "params.insuranceLabel",
    "in": "popup"
   },
   {
    "event": "click OK",
    "action": "click",
    "selector": "input[name=\"ok\"]",
    "in": "popup"
   },
   {
    "event": "ast 反映確認",
    "action": "assert",
    "assert": "value",
    "selector": "#selected_insurance_item_code",
    "note": "mock回写；实际SUT确认显示"
   }
  ]
 },
 "BLK-AZ-AGENT-SELECT": {
  "screen": "AZG100+popup",
  "steps": [
   {
    "event": "click (募集人ID欄の横)",
    "action": "click",
    "selector": "input[name=\"selectFieldAgent\"]",
    "in": null
   },
   {
    "event": "ast 遷移 募集人検索",
    "action": "popup",
    "match": "AZG905|agent.html|AMA18"
   },
   {
    "event": "input 部店課支社コード",
    "action": "fill",
    "selector": "#section_code_key",
    "value": "params.sectionCode",
    "in": "popup"
   },
   {
    "event": "input 代理店コード",
    "action": "fill",
    "selector": "#agent_code_key",
    "value": "params.agentCode",
    "in": "popup"
   },
   {
    "event": "input 募集人ID",
    "action": "fill",
    "selector": "#field_agent_id_key",
    "value": "params.fieldAgentId",
    "in": "popup"
   },
   {
    "event": "click 検索",
    "action": "click",
    "selector": "#search",
    "in": "popup"
   },
   {
    "event": "ast 結果行",
    "action": "assert",
    "assert": "rows",
    "selector": "#gyoumu_list tr",
    "min": 1,
    "in": "popup",
    "note": "009环境无数据=blocked"
   },
   {
    "event": "click 選択欄ラジオ",
    "action": "click",
    "selector": "tr:has-text(\"{params.fieldAgentId}\") input[type=radio]",
    "in": "popup"
   },
   {
    "event": "click 選択",
    "action": "click",
    "selector": "input[name=\"closeSelect\"]",
    "in": "popup"
   },
   {
    "event": "ast 反映確認",
    "action": "assert",
    "assert": "value",
    "selector": "#field_agent_id",
    "equals": "params.fieldAgentId",
    "in": null
   }
  ]
 },
