 "BLK-AZ-CORRECTION-CONFIRM": {
  "screen": "AZG101+AZG906",
  "steps": [
   {
    "event": "click 訂正内容確認書",
    "action": "click",
    "selector": "input[name=\"act101to906\"]"
   },
   {
    "event": "ast 遷移 訂正内容確認",
    "action": "popup",
    "match": "AMA19|aZG906"
   },
   {
    "event": "input 確認者",
