{
 "BLK-AZ-MENU-CREATE-INPUT": {
  "screen": "AZG001",
  "steps": [
   {
    "event": "click 新規登録",
    "action": "click",
    "selector": "#act001to100",
    "source": "html-captured"
   },
   {
    "event": "ast transition 不備内容入力画面-新規",
    "action": "assert",
    "assert": "visible",
    "selector": "#policy_number"
   }
  ]
 },
 "BLK-AZ-INPUT-FILL": {
  "screen": "AZG100",
  "steps": [
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "select[name=\"input_type_list.selected\"]",
    "value": "params.inputType",
    "how": "select"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "select[name=\"large_item_list.selected\"]",
    "value": "params.largeItemValue",
    "how": "select"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#policy_number",
    "value": "params.policyNo"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#sub_policy_number",
    "value": "params.detailNo"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#section_code",
    "value": "params.sectionCode"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#agent_code",
    "value": "params.agentCode"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#sub_agent_code",
    "value": "params.subAgentCode"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#free_code_1",
    "value": "params.freeCode"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#insurant_name",
    "value": "params.customerName"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#start_date",
    "value": "params.startDate"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "select[name=\"application_form_type_list.selected\"]",
    "value": "params.applicationType",
    "how": "select"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#sumup_year_month",
    "value": "params.sumupYearMonth"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#daily_report_send",
    "value": "params.dailyReportSend"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#sumup_section_code",
    "value": "params.sumupSectionCode"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "select[name=\"sumup_status_list.selected\"]",
    "value": "params.sumupStatus",
    "how": "select"
   },
   {
    "event": "inputBundle 各項目",
    "action": "fill",
    "selector": "#reminder_date",
    "value": "params.reminderDate"
   },
   {
    "event": "ast bundle 表示",
    "action": "assert",
    "assert": "value",
    "selector": "#selected_input_type_code",
    "equals": "params.inputType"
   }
  ]
 },
 "BLK-AZ-INSURANCE-SELECT": {
  "screen": "AZG100+popup",
  "steps": [
   {
    "event": "click (保険種類欄の横)",
    "action": "click",
    "selector": "input[name=\"selectInsuransuItem\"]"
   },
   {
    "event": "ast 遷移 保険種類選択",
    "action": "popup",
    "match": "insurance_item_select|popup.html"
   },
   {
    "event": "click 保険種類",
    "action": "selectOptionByLabel",
    "selector": "select[name=\"insurance_item_list.selected\"]",
    "label": "params.insuranceLabel",
    "in": "popup"
   },
   {
    "event": "click OK",
    "action": "click",
    "selector": "input[name=\"ok\"]",
    "in": "popup"
   },
   {
    "event": "ast 反映確認",
    "action": "assert",
    "assert": "value",
    "selector": "#selected_insurance_item_code",
    "note": "mock回写；实际SUT确认显示"
   }
  ]
 },
 "BLK-AZ-AGENT-SELECT": {
  "screen": "AZG100+popup",
  "steps": [
   {
    "event": "click (募集人ID欄の横)",
    "action": "click",
    "selector": "input[name=\"selectFieldAgent\"]",
    "in": null
   },
   {
    "event": "ast 遷移 募集人検索",
    "action": "popup",
    "match": "AZG905|agent.html"
   },
   {
    "event": "input 部店課支社コード",
    "action": "fill",
    "selector": "#section_code_key",
    "value": "params.sectionCode",
    "in": "popup"
   },
   {
    "event": "input 代理店コード",
    "action": "fill",
    "selector": "#agent_code_key",
    "value": "params.agentCode",
    "in": "popup"
   },
   {
    "event": "click 検索",
    "action": "click",
    "selector": "#search",
    "in": "popup"
   },
   {
    "event": "ast 結果行",
    "action": "assert",
    "assert": "rows",
    "selector": "#gyoumu_list tr",
    "min": 1,
    "in": "popup",
    "note": "009环境无数据=blocked"
   },
   {
    "event": "click 選択欄ラジオ",
    "action": "click",
    "selector": "tr:has-text(\"{params.fieldAgentId}\") input[type=radio]",
    "in": "popup"
   },
   {
    "event": "click 選択",
    "action": "click",
    "selector": "input[name=\"closeSelect\"]",
    "in": "popup"
   },
   {
    "event": "ast 反映確認",
    "action": "assert",
    "assert": "value",
    "selector": "#field_agent_id",
    "equals": "params.fieldAgentId",
    "in": null
   }
  ]
 }
}