 "BLK-AZ-COMPLETE-REGISTER": {
  "screen": "AZG101",
  "steps": [
   {
    "event": "click 完了登録",
    "action": "click",
    "selector": "input[name=\"updateCompleteDate\"]",
    "force": true
   },
   {
    "event": "ast エラーメッセージ MAZG101W047",
    "action": "assert",
    "assert": "text",
    "selector": "body",
    "contains": "MAZG101W047",
    "note": "mock无后端消息，真SUT断言",
    "optional": true
   },
   {
    "event": "click 更新",
    "action": "click",
    "selector": "input[name=\"update\"]",
    "force": true
   },
   {
    "event": "ast 営業対応状況 未対応",
    "action": "assert",
    "assert": "visible",
    "selector": "input[name=\"update\"]"
   }
  ]
 }
