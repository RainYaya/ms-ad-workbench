{
 "BLK-AY-MENU-SEARCH": {
  "screen": "AYG001->Kensaku",
  "cases": [
   "AY-110-01-011",
   "AY-110-01-012"
  ],
  "steps": [
   {
    "event": "goto start screen",
    "action": "goto",
    "url": "/ANB00/ANA01.html"
   },
   {
    "event": "click route3",
    "action": "click",
    "selector": "input[name='route3']"
   },
   {
    "event": "ast transition",
    "action": "assert",
    "assert": "visible",
    "selector": "#select"
   }
  ]
 },
 "BLK-AY-SEARCH-OPEN": {
  "screen": "Kensaku->Shinsei",
  "cases": [
   "AY-110-01-011",
   "AY-110-01-012"
  ],
  "steps": [
   {
    "event": "fill policy",
    "action": "fill",
    "selector": "#policy_number",
    "value": "params.policyNo"
   },
   {
    "event": "click search",
    "action": "click",
    "selector": "#select"
   },
   {
    "event": "assert rows",
    "action": "assert",
    "assert": "rows",
    "selector": "#gyoumu_list a",
    "min": 1
   },
   {
    "event": "click No link",
    "action": "click",
    "selector": "#gyoumu_list a"
   },
   {
    "event": "ast update screen",
    "action": "assert",
    "assert": "visible",
    "selector": "input[name='update']"
   }
  ]
 },
 "BLK-AY-UPDATE": {
  "screen": "Shinsei",
  "cases": [
   "AY-110-01-011",
   "AY-110-01-012"
  ],
  "steps": [
   {
    "event": "ast 更新ボタン存在",
    "action": "assert",
    "assert": "visible",
    "selector": "input[name='update']"
   }
  ]
 }
}